// use prisma-next

model User {
  id           String @id @default(uuid())
  username     String
  email        String @unique
  hashPassword String

  workspaces Workspace[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String

  createdAt DateTime @default(now())
  updatedAt DateTime

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}
