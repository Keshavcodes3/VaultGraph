# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Required for auth (JWT). Generate with: openssl rand -base64 32
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

PORT=4000

# ---- deploy ----
# Public URL of the web app (exact origin, no trailing slash).
# Required in production so CORS + cookies work, e.g.
# WEB_ORIGIN="https://vaultgraph.vercel.app"
WEB_ORIGIN="http://localhost:3000"

# Set to "production" on Render — switches auth cookies to
# SameSite=None; Secure (required for Vercel + Render split domains).
NODE_ENV="development"

# Leave unset so the API auto-creates/upgrades tables on boot
# (used for the first deploy against an empty Postgres).
# Set to "1" only if you manage schema with real migrations.
# SKIP_SCHEMA_BOOTSTRAP="1"
